    "base.alcubierre-warp-drive": {
      "Name": "Alcubierre Warp Drive",
      "DescriptionFormula": "'Warps a ship through non newtonion space'",
      "MassFormula": "Ability('Mass')",
      "VolumeFormula": "Max(1, Ability('Mass'))",
      "HTKFormula": "Max(1, [Mass] / 100)",
      "CrewReqFormula": "[Mass]",
      "ResourceCostFormula": {
        "base.gallicite": "[Mass] * 8"
      },
      "ResearchCostFormula": "[Mass] * 1",
      "CreditCostFormula": "[Mass]",
      "BuildPointCostFormula": "[Mass]",
      "MountType": "ShipComponent, ShipCargo, Fighter",
      "CargoTypeID": "base.storage-general",
      "IndustryTypeID": "base.component-construction",
      "ComponentAtbSDs": [
        {
          "Name": "Mass",
          "Units": "kg",
          "DescriptionFormula": "'Mass of the engine'",
          "GuiHint": "GuiSelectionMaxMin",
          "MaxFormula": "25000",
          "MinFormula": "TechData('base.tech-alcubierre-miniaturization')",
          "StepFormula": "1",
          "AttributeFormula": "2500"
        },
        {
          "Name": "Efficency vs Power",
          "Units": "EvP",
          "DescriptionFormula": "'More Powerful engines are less efficient for a given size'",
          "GuiHint": "GuiSelectionMaxMin",
          "MaxFormula": "TechData('base.tech-engine-max-size')",
          "MinFormula": "TechData('base.tech-engine.min-size')",
          "StepFormula": "0.1",
          "AttributeFormula": "1"
        },
        {
          "Name": "EnginePower",
          "Units": "EP",
          "DescriptionFormula": "'Move Power for ship'",
          "GuiHint": "GuiTextDisplay",
          "AttributeFormula": "Ability('Efficency vs Power') * [Mass] * 1000"
        },
        {
          "Name": "Bubble Creation Energy Cost",
          "Units": "KJ",
          "DescriptionFormula": "'How much energy required to create the warp bubble.'",
          "GuiHint": "GuiTextDisplay",
          "AttributeFormula": "Ability('EnginePower') * TechData('base.tech-alcubierre-bubble-creation-cost') * 0.5"
        },
        {
          "Name": "Bubble Sustain Energy Cost",
          "Units": "KW",
          "DescriptionFormula": "'How much energy required to sustain the warp bubble per second during the warp'",
          "GuiHint": "GuiTextDisplay",
          "AttributeFormula": "Ability('EnginePower') * 0.001 * TechData('base.tech-alcubierre-sustain-cost')"
        },
        {
          "Name": "Bubble Collapse Energy Returned",
          "Units": "KJ",
          "DescriptionFormula": "'How much energy we get back from collapsing the warp bubble'",
          "GuiHint": "GuiTextDisplay",
          "AttributeFormula": "Ability('Bubble Creation Energy Cost') * TechData('base.tech-alcubierre-collapse-efficency')"
        },
        {
          "Name": "db",
          "GuiHint": "None",
          "AttributeFormula": "AtbConstrArgs(Ability('EnginePower'), 'base.electricity', Ability('Bubble Creation Energy Cost'), Ability('Bubble Sustain Energy Cost'), -Ability('Bubble Collapse Energy Returned'))",
          "AttributeType": "Pulsar4X.ECSLib.WarpDriveAtb"
        }
      ]
    }
